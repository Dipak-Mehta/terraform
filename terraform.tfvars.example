# Copy this file to terraform.tfvars and change only the values you need.

aws_region        = "ap-south-1"
project_name      = "terraform-aws-infra"

vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
availability_zone   = "ap-south-1a"

# IMPORTANT: restrict SSH to your own public IP.
# Example: 203.0.113.10/32
allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"

# This must already exist in EC2 > Key Pairs in the selected AWS region.
key_name = "YOUR_EXISTING_KEYPAIR_NAME"

# Optional. Leave empty to automatically discover the latest Ubuntu 24.04 LTS AMD64 AMI.
ami_id = ""

instance_type = "t3.micro"

public_instance_name  = "public-instance"
private_instance_name = "private-instance"
